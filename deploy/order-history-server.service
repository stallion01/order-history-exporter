# Runs the database server on Linux at startup. To install:
#   1. Copy this repository to /opt/order-history-exporter
#   2. Create a user:  sudo useradd --system --home /var/lib/order-history order-history
#   3. Create its data folder:
#        sudo mkdir -p /var/lib/order-history
#        sudo chown order-history /var/lib/order-history
#        sudo chmod 700 /var/lib/order-history
#   4. Copy this file to /etc/systemd/system/
#   5. sudo systemctl enable --now order-history-server
#   6. Read the token:  sudo cat /var/lib/order-history/token
[Unit]
Description=Order History Exporter database server
After=network-online.target
Wants=network-online.target

[Service]
User=order-history
WorkingDirectory=/opt/order-history-exporter
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/index.js --network
Environment=OHE_DATA_DIR=/var/lib/order-history
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/order-history

[Install]
WantedBy=multi-user.target
