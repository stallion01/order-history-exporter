{
  "manifest_version": 3,
  "name": "Order History Exporter",
  "version": "0.1.0",
  "description": "Export your own purchase history from Amazon, Walmart, Sam's Club, eBay, Newegg and Home Depot to CSV, and send Venmo statements to your own Business Hub. Nothing goes anywhere else.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Order History Exporter",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.walmart.com/*",
    "https://www.samsclub.com/*",
    "https://www.ebay.com/*",
    "https://order.ebay.com/*",
    "https://secure.newegg.com/*",
    "https://www.homedepot.com/*",
    "https://account.venmo.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "web_accessible_resources": [
    { "resources": ["src/app/app.html"], "matches": ["https://*.ts.net/*", "http://127.0.0.1/*", "http://localhost/*"] }
  ]
}
